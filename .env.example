# GRAND production environment template. Copy values into the deployment's
# secret/environment manager; do not commit a populated .env file.
DJANGO_SETTINGS_MODULE=src.settings.prod
SKEY=replace-with-a-long-random-production-secret
GRAND_ALLOWED_HOSTS=grand.example.gov.ph,grand-service.onrender.com
GRAND_CSRF_TRUSTED_ORIGINS=https://grand.example.gov.ph,https://grand-service.onrender.com
PORT=10000
WEB_CONCURRENCY=2
GUNICORN_CMD_ARGS=--timeout 120 --graceful-timeout 30
GRAND_LOG_LEVEL=INFO
GRAND_SECURE_HSTS_SECONDS=3600
GRAND_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
GRAND_SECURE_HSTS_PRELOAD=false

# Main/default MySQL store
DEFAULT_DB_NAME=grand
DEFAULT_DB_USER=replace-me
DEFAULT_DB_PASSWORD=replace-me
DEFAULT_DB_HOST=replace-me
DEFAULT_DB_PORT=3306

# Separately routed Finance MySQL store
FINANCE_DB_NAME=grand_finance
FINANCE_DB_USER=replace-me
FINANCE_DB_PASSWORD=replace-me
FINANCE_DB_HOST=replace-me
FINANCE_DB_PORT=3306

GRAND_DB_CONNECT_TIMEOUT=10
GRAND_DB_READ_TIMEOUT=30
GRAND_DB_WRITE_TIMEOUT=30
GRAND_DB_CONN_MAX_AGE=60

# Runtime file roots. On Docker/Render these must live below the approved
# persistent mount or use an approved external object-storage implementation.
GRAND_MEDIA_ROOT=/app/runtime/media
GRAND_EXPORT_ROOT=/app/runtime/exports
GRAND_BACKUP_ROOT=/app/runtime/backups
GRAND_BACKUP_RETENTION_COUNT=0
GRAND_MYSQL_DUMP_COMMAND=mysqldump

EMAIL_HOST=replace-me
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
ASSISTANCE_FROM_EMAIL=replace-me
NOTIFICATIONS_FROM_EMAIL=replace-me
PW_RESET_FROM_EMAIL=replace-me

GAUTH_CLIENTID=replace-me
GAUTH_SECRET=replace-me
