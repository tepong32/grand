{
  "patterns": {
    "private-key": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----",
    "provider-token": "(?<![A-Za-z0-9])(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{35,}|sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{25,}|AKIA[A-Z0-9]{16}|AIza[A-Za-z0-9_-]{30,}|GOCSPX-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{20,})",
    "telegram-token": "(?<![0-9])[0-9]{7,12}:[A-Za-z0-9_-]{30,}",
    "url-userinfo": "[A-Za-z][A-Za-z0-9+.-]*://[^\\s:/<>\\\"\\']{1,80}:[^\\s@/<>\\\"\\']{1,150}@",
    "literal-assignment": "(?i)\\b(?:[A-Z0-9_]*(?:password|passwd|secret|api_key|apikey|access_token|auth_token|bot_token|secret_key|secret_access_key|client_secret|signing_key|encryption_key)|SKEY)[\\\"\\']?\\s*[=:]\\s*[\\\"\\']([^\\\"\\'\\r\\n]{6,})[\\\"\\']",
    "possible-jwt": "\\beyJ[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\b"
  },
